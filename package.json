{
  "name": "doq-pilot",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.18.3",
  "scripts": {
    "build": "turbo run build",
    "dev:a": "pnpm --filter showcase-a dev",
    "dev:b": "pnpm --filter showcase-b dev",
    "build:doq": "pnpm --filter @getdoq/analog build",
    "pack:doq": "pnpm --filter @getdoq/analog run pack",
    "typecheck:scripts": "tsc -p scripts/tsconfig.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify:mvp": "node scripts/verification/mvp.ts",
    "verify:package": "node scripts/verification/package.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "prettier": "^3.9.10",
    "turbo": "^2.5.6",
    "typescript": "~5.9.3"
  },
  "engines": {
    "node": ">=22.22.3"
  }
}
