/** What went wrong; selects the exit code and the wording of a report. */
export type DoqContentErrorKind = 'config' | 'invalid-authoring' | 'missing-source' | 'unsafe-path' | 'unknown-symbol' | 'ambiguous-symbol' | 'stale' | 'conflict';

/** Process exit codes of `doq content`: stale output 1, configuration 2, output conflict 3, invalid authoring 4. */
export const EXIT_CODES: Readonly<{ stale: 1; config: 2; conflict: 3; authoring: 4 }>;
/** Default name of the configuration file, read from the project root. */
export const CONFIG_FILE: 'doq.content.json';

/** A failure with a user-facing message. `diagnostics` is set when authored pages are invalid. */
export class DoqContentError extends Error {
  kind: DoqContentErrorKind;
  exitCode: number;
  diagnostics?: DoqContentDiagnostic[];
}

/** One problem located in the page (or fragment) the author wrote. */
export interface DoqContentDiagnostic {
  kind: DoqContentErrorKind;
  /** Project-relative path of the authored page or fragment. */
  file: string;
  /** 1-based line. */
  line: number;
  /** `::source`, `::include`, `[[api:]]` or `page`. */
  directive: string;
  reference: string;
  message: string;
  hint?: string;
}

// #region doqs:target-config
/** One documentation version: its authored pages, where the resolved Markdown goes and what it may read. */
export interface DoqContentTarget {
  /** Unique name, also the `@name` of cross-version API links. Optional for a single target (defaults to "current"). */
  name?: string;
  /** Directory of authored pages and `_`-prefixed fragments, relative to the project. */
  authoring: string;
  /** Directory the resolved pages are written to (usually the Analog content directory). Never overwritten files you wrote. */
  out: string;
  /** Directories `::source` may read from. Without any, `::source` is refused. */
  sourceRoots?: string[];
  /** Directories generated by `doq-api` whose `.doq-api.json` supplies the symbol index for `[[api:Name]]`. */
  api?: string[];
  /** Link template for "View source", `http(s)://…` with `{path}` and optionally `{revision}` and `{lines}`. */
  sourceUrl?: string;
  /** Replaces `{revision}` in `sourceUrl`: a tag or commit. Never guessed. */
  revision?: string;
  /** Prepended to the project-relative path in `{path}` (for a monorepo package directory). */
  sourcePathPrefix?: string;
  /** Replaces `{lines}` for a region or range. Default `#L{start}-L{end}`. */
  sourceLines?: string;
}
// #endregion doqs:target-config

/** Where to run and what to resolve: a project directory plus a configuration file or inline targets. */
export interface DoqContentOptions {
  /** Project root. Default `process.cwd()`. */
  cwd?: string;
  /** Configuration file, default `doq.content.json`. Ignored when `targets` is given. */
  config?: string;
  targets?: DoqContentTarget[];
}

/** What `generateContent` did for one target. */
export interface DoqContentTargetResult {
  name: string;
  outDir: string;
  pageCount: number;
  written: string[];
  removed: string[];
}

/** Result of `generateContent`. */
export interface GenerateContentResult {
  /** Real paths of every authored page, fragment and source file that was read. */
  dependencies: string[];
  authoringRoots: string[];
  targets: DoqContentTargetResult[];
}

/** What `checkContent` found for one target; `upToDate` is true only when nothing would change. */
export interface CheckContentTargetResult {
  name: string;
  outDir: string;
  pageCount: number;
  added: string[];
  modified: string[];
  removed: string[];
  conflicts: string[];
  upToDate: boolean;
}

/** Result of `checkContent`. */
export interface CheckContentResult {
  dependencies: string[];
  targets: CheckContentTargetResult[];
  upToDate: boolean;
  conflicts: string[];
}

/** Result of `buildContent`: the resolved pages in memory and every problem found. */
export interface BuildContentResult {
  cwd: string;
  /** Resolved pages in memory: path relative to `out` → Markdown. */
  results: { name: string; outDir: string; authoringRoot: string; files: Map<string, string> }[];
  diagnostics: DoqContentDiagnostic[];
  dependencies: string[];
}

/** Resolves the pages in memory. Writes nothing. */
export function buildContent(options?: DoqContentOptions): Promise<BuildContentResult>;
/** Writes the resolved pages, touching only files it owns. Throws `DoqContentError` (nothing is written) for invalid authoring or conflicts. */
export function generateContent(options?: DoqContentOptions): Promise<GenerateContentResult>;
/** Compares the resolved pages with the output directories; never writes. */
export function checkContent(options?: DoqContentOptions): Promise<CheckContentResult>;
/** Reads and validates the configuration without touching any content. */
export function loadContentConfig(options?: DoqContentOptions): Promise<{ cwd: string; targets: Required<DoqContentTarget>[] }>;
/** Formats a diagnostic as the multi-line text the CLI prints. */
export function formatDiagnostic(diagnostic: DoqContentDiagnostic): string;

/** Minimal structural type of the Vite plugin, so the package needs no dependency on Vite. */
export interface DoqContentVitePlugin {
  name: string;
  enforce: 'pre';
  buildStart(this: unknown): Promise<void>;
  configureServer(server: { watcher: { on(event: string, listener: (file: string) => void): unknown }; config: { logger: { error(message: string): void } } }): void;
}

/** A Vite plugin that resolves the content on build start and re-resolves it, using Vite's watcher, when an authored page, fragment, source file or API index changes. */
export function doqContent(options?: DoqContentOptions): DoqContentVitePlugin;
