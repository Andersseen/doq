{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noImplicitOverride": true,
    "useDefineForClassFields": false,
    "experimentalDecorators": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "angularCompilerOptions": { "strictTemplates": true },
  "include": ["src/**/*.ts", "test/**/*.ts"]
}
