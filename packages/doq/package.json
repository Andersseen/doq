{
  "name": "@getdoq/analog",
  "version": "0.1.0",
  "description": "Composable Markdown documentation UI for Analog.js",
  "type": "module",
  "peerDependencies": {
    "@analogjs/content": "^2.9.0",
    "@angular/common": "^21.2.2 || ^22.0.0",
    "@angular/core": "^21.2.2 || ^22.0.0",
    "@angular/platform-browser": "^21.2.2 || ^22.0.0",
    "@angular/router": "^21.2.2 || ^22.0.0",
    "rxjs": "^7.8.0"
  },
  "dependencies": { "tslib": "^2.3.0" },
  "sideEffects": ["./styles.css"],
  "module": "./dist/fesm2022/getdoq-analog.mjs",
  "typings": "./dist/types/getdoq-analog.d.ts",
  "files": ["fesm2022", "types", "styles.css", "README.md", "CHANGELOG.md"],
  "exports": {
    ".": { "types": "./dist/types/getdoq-analog.d.ts", "default": "./dist/fesm2022/getdoq-analog.mjs" },
