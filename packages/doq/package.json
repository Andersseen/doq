  },
  "scripts": { "build": "ng-packagr -p ng-package.json", "pack": "pnpm build && cd dist && pnpm pack --pack-destination ../../../artifacts" },
  "devDependencies": {
    "@angular/common": "^21.2.2", "@angular/compiler": "^21.2.2", "@angular/compiler-cli": "^21.2.2", "@angular/core": "^21.2.2", "@angular/platform-browser": "^21.2.2", "@angular/router": "^21.2.2", "rxjs": "^7.8.0",
    "ng-packagr": "^21.2.2", "typescript": "~5.9.3"
  }
}
